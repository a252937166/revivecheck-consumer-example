{
  "name": "revivecheck-consumer-example",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A token eligibility demo: a DEX allow-list that enables a token only while its own ReviveCheck policy evaluation is valid and the entry equals the approved report, and prepares a versioned token-catalog release from the eligible entry that a separate reader consumes. Installs ReviveCheck from a packed tarball; a second consumer outside the ReviveCheck source tree, with a command line and a public browser interface.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node src/check.js",
    "check:fixture": "node src/check.js --fixture fixtures/valid-r2.json",
    "reconstruct": "node src/reconstruct.js",
    "release": "revivecheck-catalog prepare --config config/allowlist.json --out out/releases --previous out/releases/catalog-release-1.json",
    "release:fixture": "revivecheck-catalog prepare --config config/allowlist.json --out .ci-out/releases --fixture fixtures/valid-r2.json",
    "release:read": "revivecheck-catalog read",
    "release:compare": "revivecheck-catalog compare",
    "test": "node --test test/*.test.js",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "fixtures:import": "node scripts/import-capture.js",
    "release:first": "revivecheck-catalog prepare --config config/allowlist.json --out out/releases",
    "journey:reader": "node test/browser/reader-expiry-journey.mjs",
    "journey:release": "node test/browser/release-journey.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "revivecheck": "file:vendor/revivecheck-0.5.3.tgz"
  }
}
